<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:DeliveryApp.Models"
             xmlns:viewmodels="clr-namespace:DeliveryApp.ViewModels"
             x:Class="DeliveryApp.Views.CarritoPage"
             Title="{Binding Titulo}"
             BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="*, Auto">

        <!-- 1. LISTA DE PRODUCTOS EN EL CARRITO -->
        <Grid Grid.Row="0" Margin="15">
            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                        <Label Text="🛒" FontSize="60" HorizontalOptions="Center" />
                        <Label Text="Tu carrito está vacío" FontSize="18" FontAttributes="Bold" TextColor="#2D3436" HorizontalOptions="Center" />
                        <Label Text="¡Explora el menú y agrega tus platos favoritos!" FontSize="14" TextColor="#636E72" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ItemCarrito">
                        <Border StrokeShape="RoundRectangle 16" 
                                BackgroundColor="White" 
                                Padding="12" 
                                Margin="0,0,0,12" 
                                Stroke="Transparent">
                            <Grid ColumnDefinitions="70, *, Auto" ColumnSpacing="12">

                                <!-- Foto -->
                                <Image Grid.Column="0" 
                                       Source="{Binding Producto.ImagenUrl}" 
                                       Aspect="AspectFill" 
                                       HeightRequest="65" 
                                       WidthRequest="65" />

                                <!-- Info del Plato -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                    <Label Text="{Binding Producto.Nombre}" FontSize="15" FontAttributes="Bold" TextColor="#2D3436" />
                                    <Label Text="{Binding Subtotal, StringFormat='${0:N0}'}" FontSize="14" FontAttributes="Bold" TextColor="#FF4757" />
                                </VerticalStackLayout>

                                <!-- Controles de Cantidad (+ / -) -->
                                <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="8">
                                    <Button Text="-" 
                                            BackgroundColor="#FFEAA7" 
                                            TextColor="#D63031" 
                                            FontAttributes="Bold" 
                                            WidthRequest="32" 
                                            HeightRequest="32" 
                                            CornerRadius="16" 
                                            Padding="0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CarritoViewModel}}, Path=DecrementarCommand}"
                                            CommandParameter="{Binding .}" />

                                    <Label Text="{Binding Cantidad}" 
                                           FontSize="15" 
                                           FontAttributes="Bold" 
                                           VerticalOptions="Center" />

                                    <Button Text="+" 
                                            BackgroundColor="#FF4757" 
                                            TextColor="White" 
                                            FontAttributes="Bold" 
                                            WidthRequest="32" 
                                            HeightRequest="32" 
                                            CornerRadius="16" 
                                            Padding="0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CarritoViewModel}}, Path=IncrementarCommand}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- 2. RESUMEN FINANCIERO Y BOTÓN CONFIRMAR -->
        <Border Grid.Row="1" 
                BackgroundColor="White" 
                Padding="20" 
                StrokeShape="RoundRectangle 24,24,0,0">
            <VerticalStackLayout Spacing="10">

                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="Subtotal" TextColor="#636E72" FontSize="14" />
                    <Label Grid.Column="1" Text="{Binding Subtotal, StringFormat='${0:N0}'}" FontAttributes="Bold" TextColor="#2D3436" FontSize="14" />
                </Grid>

                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="Costo de Envío (Domicilio 🛵)" TextColor="#636E72" FontSize="14" />
                    <Label Grid.Column="1" Text="{Binding CostoEnvio, StringFormat='${0:N0}'}" FontAttributes="Bold" TextColor="#00B894" FontSize="14" />
                </Grid>

                <BoxView HeightRequest="1" Color="#DFE6E9" Margin="0,5" />

                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="Total a Pagar" FontAttributes="Bold" TextColor="#2D3436" FontSize="18" />
                    <Label Grid.Column="1" Text="{Binding Total, StringFormat='${0:N0}'}" FontAttributes="Bold" TextColor="#FF4757" FontSize="20" />
                </Grid>

                <!-- Botón de Confirmación -->
                <Button Text="Confirmar y Enviar Pedido 🚀" 
                        BackgroundColor="#FF4757" 
                        TextColor="White" 
                        FontSize="16" 
                        FontAttributes="Bold" 
                        CornerRadius="16" 
                        HeightRequest="50" 
                        Margin="0,10,0,0"
                        Command="{Binding RealizarPedidoCommand}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>